@using System.Linq
@model List<ResumeProjectDemoNight.Entities.About>

@{
    ViewData["Title"] = "About Details";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-4xl mx-auto space-y-8">

        <div>
            <h3 class="text-2xl font-bold text-white">Hakkımda Alanı</h3>
            <p class="text-slate-400 text-sm mt-1">Sitenin "Öne Çıkan" alanında görünen profil bilgileriniz.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="bg-card-dark rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
                    <div class="h-32 bg-gradient-to-r from-blue-900 to-slate-900"></div>

                    <div class="px-8 pb-8">
                        <div class="relative -mt-16 mb-6">
                            <div class="size-32 rounded-full border-4 border-card-dark overflow-hidden bg-slate-800">
                                <img src="@item.ImageUrl" alt="Profile" class="w-full h-full object-cover" />
                            </div>
                        </div>

                        <div class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                                <div>
                                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Ad Soyad</label>
                                    <p class="text-xl font-bold text-white mt-1">@item.NameSurname</p>
                                </div>

                                <div>
                                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Unvan</label>
                                    <p class="text-xl font-bold text-white mt-1">@item.Title</p>
                                </div>
                            </div>

                            <div>
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Açıklama</label>
                                <div class="mt-2 p-4 bg-slate-900/50 rounded-lg border border-slate-700/50">
                                    <p class="text-slate-300 leading-relaxed">@item.Description</p>
                                </div>
                            </div>

                            <div class="pt-6 border-t border-slate-800 flex justify-end">
                                <a href="/About/UpdateAbout/@item.AboutId"
                                   class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-lg font-bold transition-all shadow-lg shadow-primary/20">
                                    <span class="material-symbols-outlined">edit</span>
                                    Bilgileri Düzenle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-8 bg-red-500/10 border border-red-500/20 rounded-lg text-center">
                <p class="text-red-400">Veritabanında veri bulunamadı. Lütfen veritabanına manuel bir kayıt ekleyin.</p>
            </div>
        }
    </div>
</div>
