@model ResumeProjectDemoNight.Entities.About

@{
    ViewData["Title"] = "Update About";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-4xl mx-auto space-y-8">

        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-2xl font-bold text-white">Profili Düzenle</h3>
            </div>
            <a href="/About/Index/" class="flex items-center gap-2 bg-slate-700 hover:bg-slate-600 text-white px-5 py-2.5 rounded-lg font-bold text-sm transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
                Geri Dön
            </a>
        </div>

        <div class="bg-card-dark rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="p-8">
                <form method="post" class="space-y-6">

                    <input type="hidden" asp-for="AboutId" />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-slate-300">Ad Soyad</label>
                            <input type="text" asp-for="NameSurname" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" required />
                        </div>

                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-slate-300">Kayan Yazı(Aralara Virgül Koymayı Unutmayın!)</label>
                            <input type="text" asp-for="Title" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Örn: I'm a Developer" required />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-300">Görsel URL</label>
                        <input type="text" asp-for="ImageUrl" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" required />
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-300">Açıklama</label>
                        <textarea asp-for="Description" rows="6" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary resize-none" required></textarea>
                    </div>

                    <div class="pt-4 border-t border-slate-800">
                        <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-lg font-bold transition-all shadow-lg shadow-primary/20">
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>