@model ResumeProjectDemoNight.Entities.Skill


@{
    ViewData["Title"] = "Yeni Yetenek Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-2xl mx-auto space-y-8">

        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-2xl font-bold text-white">Yeni Yetenek Ekle</h3>
            </div>
            <a href="/Skill/Index/" class="flex items-center gap-2 bg-slate-700 hover:bg-slate-600 text-white px-5 py-2.5 rounded-lg font-bold text-sm transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
                Geri Dön
            </a>
        </div>

        <div class="bg-card-dark rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="p-8">
                <form method="post" class="space-y-6">

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-300">Yetenek Adı</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-500">code</span>
                            <input type="text" asp-for="Title" class="w-full pl-12 pr-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Örn: C#, React, SQL" required />
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex justify-between">
                            <label class="block text-sm font-semibold text-slate-300">Yetenek Seviyesi (%)</label>
                            <span class="text-primary font-bold" id="rangeValue">50%</span>
                        </div>

                        <input type="range" min="0" max="100" value="50" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-primary" oninput="document.getElementById('SkillValue').value = this.value; document.getElementById('rangeValue').innerText = this.value + '%'">

                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-500">percent</span>
                            <input type="number" asp-for="Value" id="SkillValue" min="0" max="100" class="w-full pl-12 pr-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="0-100 arası" required />
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-800">
                        <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-lg font-bold transition-all">Yetenek Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>