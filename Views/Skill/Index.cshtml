@model List<ResumeProjectDemoNight.Entities.Skill>


@{
    ViewData["Title"] = "Yetenek Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-5xl mx-auto space-y-8">

        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-2xl font-bold text-white">Yetenek Listesi</h3>
                <p class="text-slate-400 text-sm mt-1">Yetenek Düzenleme</p>
            </div>
            <a href="/Skill/AddSkill" class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-5 py-2.5 rounded-lg font-bold text-sm transition-all shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined">add</span>
                Yeni Yetenek Ekle
            </a>
        </div>

        <div class="bg-card-dark rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-900/50">
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">#</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Yetenek Adı</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Oran (%)</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Durum</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-800/30 transition-colors group">
                                <td class="px-6 py-5 text-slate-300">@item.SkillId</td>
                                <td class="px-6 py-5 font-bold text-white">@item.Title</td>
                                <td class="px-6 py-5 text-slate-300 font-mono">%@item.Value</td>
                                <td class="px-6 py-5 w-1/3">
                                    <div class="w-full bg-slate-700 rounded-full h-2.5 overflow-hidden">
                                        <div class="bg-primary h-2.5 rounded-full" style="width: @item.Value%"></div>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="/Skill/DeleteSkill/@item.SkillId" class="p-2 bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white rounded-lg transition-colors">
                                            <span class="material-symbols-outlined" style="font-size: 20px;">delete</span>
                                        </a>
                                        <a href="/Skill/UpdateSkill/@item.SkillId" class="p-2 bg-blue-500/10 text-blue-500 hover:bg-blue-500 hover:text-white rounded-lg transition-colors">
                                            <span class="material-symbols-outlined" style="font-size: 20px;">edit</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>