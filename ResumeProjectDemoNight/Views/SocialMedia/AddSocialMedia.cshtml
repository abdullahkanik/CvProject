@model ResumeProjectDemoNight.Entities.SocialMedia

@{
    ViewData["Title"] = "Yeni Hesap Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-4xl mx-auto space-y-8">

        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-2xl font-bold text-white">Yeni Sosyal Medya Hesabı</h3>
            </div>
            <a href="/SocialMedia/Index/" class="flex items-center gap-2 bg-slate-700 hover:bg-slate-600 text-white px-5 py-2.5 rounded-lg font-bold text-sm transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
                Geri Dön
            </a>
        </div>

        <div class="bg-card-dark rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="p-8">
                <form method="post" class="space-y-6">

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-300">Platform Adı</label>
                        <input type="text" asp-for="Name" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Örn: Instagram, Github" required />
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-300">Link (Url)</label>
                        <input type="text" asp-for="Url" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="https://..." required />
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-slate-300">İkon Sınıfı (FontAwesome)</label>
                        <input type="text" asp-for="Icon" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Örn: fab fa-instagram" required />
                        <p class="text-xs text-slate-500 mt-1">FontAwesome ikon kodunu giriniz (örn: fab fa-twitter, fab fa-linkedin).</p>
                    </div>

                    <div class="pt-4 border-t border-slate-800">
                        <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-lg font-bold transition-all">Hesabı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>