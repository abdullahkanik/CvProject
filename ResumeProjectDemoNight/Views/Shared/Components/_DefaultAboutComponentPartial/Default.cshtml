@model ResumeProjectDemoNight.Entities.About
<section id="about">

	<div class="container">

		<!-- section title -->
		<h2 class="section-title wow fadeInUp">Hakkımda</h2>

		<div class="spacer" data-height="60"></div>

		<div class="row">

			<div class="col-md-3">
				<div class="text-center text-md-left">
					<!-- avatar image -->
					<img src="@Model.ImageUrl" alt="@Model.NameSurname" />
				</div>
				<div class="spacer d-md-none d-lg-none" data-height="30"></div>
			</div>

			<div class="col-md-9 triangle-left-md triangle-top-sm">
				<div class="rounded bg-white shadow-dark padding-30">
					<div class="row">
						<div class="col-md-6">
							<!-- about text -->
							<p>@Model.Description</p>
							<div class="mt-3">
								<a href="https://drive.google.com/file/d/17A2n4vLznQqiGa-lVfSns3kb_TJAc7bX/view?usp=sharing" class="btn btn-default">CV İndir</a>
							</div>
							<div class="spacer d-md-none d-lg-none" data-height="30"></div>
						</div>
                        <div class="col-md-6">
							<!-- skill item -->
							@if (ViewBag.SkillList != null)
							{

								string[] colors = { "#FFD15C", "#FF4C60", "#6C6CE5" };
								int colorIndex = 0;

								foreach (var item in ViewBag.SkillList as List<ResumeProjectDemoNight.Entities.Skill>)
								{

									string currentColor = colors[colorIndex % colors.Length];
									colorIndex++;

									<div class="skill-item">
										<div class="skill-info clearfix">
											<h4 class="float-left mb-3 mt-0">@item.Title</h4>
											<span class="float-right">@item.Value%</span>
										</div>
										<div class="progress">
											<div class="progress-bar data-background" role="progressbar"
												 aria-valuemin="0" aria-valuemax="100"
												 aria-valuenow="@item.Value"
												 data-color="@currentColor"
												 style="width: @item.Value%; background-color: @currentColor">
											</div>
										</div>
										<div class="spacer" data-height="20"></div>
									</div>
								}
							}
						</div>
					</div>
				</div>
			</div>

		</div>

		<div class="spacer" data-height="70"></div>

		

	</div>

</section>