@model List<ResumeProjectDemoNight.Entities.Portfolio>

@{
    ViewData["Title"] = "PortfolioList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="bg-gray-900 rounded-lg p-6">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-2xl font-semibold text-white">Projeler</h2>
            <p class="text-gray-400 text-sm mt-1">Projelerinizi buradan yönetebilirsiniz.</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="bg-slate-700 text-white px-3 py-1 rounded-full text-sm">
                Toplam: @Model.Count
            </span>

            <a href="/Portfolio/CreatePortfolio/"
               class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                + Yeni Proje
            </a>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-700 text-gray-400 text-sm">
                    <th class="text-left py-3 px-4">#</th>
                    <th class="text-left py-3 px-4">Başlık</th>
                    <th class="text-left py-3 px-4">Durum</th>
                    <th class="text-center py-3 px-4">İşlem</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    var isActive = ((item.Status.ToString() ?? "").ToLower()).Contains("aktif")
                || ((@item.Status.ToString() ?? "").ToLower()).Contains("active")
                || (item.Status.ToString() ?? "") == "1";

                    <tr class="border-b border-gray-800 hover:bg-gray-800 transition-colors">
                        <td class="py-4 px-4 text-gray-300">@item.PortfolioId</td>

                        <td class="py-4 px-4">
                            <span class="text-white font-medium">@item.ProjectTitle</span>
                        </td>

                        <td class="py-4 px-4">
                            @if (isActive)
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-green-600 text-white">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-gray-700 text-gray-200">
                                    Pasif
                                </span>
                            }
                        </td>

                        <td class="py-4 px-4">
                            <div class="flex items-center justify-center gap-2">
                                <a href="/Portfolio/UpdatePortfolio/@item.PortfolioId"
                                   class="p-2 hover:bg-gray-700 rounded-lg transition-colors"
                                   title="Güncelle">
                                    <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                </a>

                                <a href="/Portfolio/DeletePortfolio/@item.PortfolioId"
                                   onclick="return confirm('Bu projeyi silmek istediğinize emin misiniz?')"
                                   class="p-2 hover:bg-gray-700 rounded-lg transition-colors"
                                   title="Sil">
                                    <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 text-center text-gray-500 text-sm">
        TOPLAM @Model.Count PROJE LİSTELENİYOR.
    </div>
</div>
