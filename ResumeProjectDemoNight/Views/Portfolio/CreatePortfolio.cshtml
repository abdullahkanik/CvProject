@model ResumeProjectDemoNight.Entities.Portfolio

@{
    ViewData["Title"] = "CreatePortfolio";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="bg-gray-900 rounded-lg p-6 max-w-2xl mx-auto">
    <div class="mb-6">
        <h2 class="text-2xl font-semibold text-white">Yeni Proje Ekle</h2>
        <p class="text-gray-400 text-sm mt-1">
            Portföyünüze yeni bir proje ekleyin.
        </p>
    </div>

    <form method="post" class="space-y-5">

        <!-- Proje Başlığı -->
        <div>
            <label class="block text-sm text-gray-400 mb-1">
                Proje Başlığı
            </label>
            <input asp-for="ProjectTitle"
                   class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="Proje başlığını giriniz" />
        </div>

        <!-- Görsel URL -->
        <div>
            <label class="block text-sm text-gray-400 mb-1">
                Görsel URL
            </label>
            <input asp-for="ImageUrl"
                   class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="https://..." />
        </div>

        <!-- Buttons -->
        <div class="flex items-center justify-between pt-4">
            <a href="/Portfolio/PortfolioList"
               class="text-gray-400 hover:text-white text-sm transition-colors">
                ← Geri Dön
            </a>

            <button type="submit"
                    class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg
                           font-semibold text-sm transition-colors">
                Projeyi Oluştur
            </button>
        </div>
    </form>
</div>
