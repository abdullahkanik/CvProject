@model ResumeProjectDemoNight.Entities.Testimonial
@{
    ViewData["Title"] = "CreateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-4xl mx-auto space-y-8">

        <!-- Page Heading -->
        <div class="flex items-center gap-4">
            <a href="/Testimonial/TestimonialList/"
               class="flex items-center justify-center w-10 h-10 rounded-lg border border-slate-200 dark:border-[#3b4d54] hover:bg-slate-50 dark:hover:bg-[#1c2427] transition-colors">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>

            <div>
                <h3 class="text-3xl font-black tracking-tight">Yeni Yorum Ekle</h3>
                <p class="text-slate-500 dark:text-[#9db2b9] mt-1">
                    Referans yorum bilgilerini ekleyin
                </p>
            </div>
        </div>

        <!-- Form Container -->
        <div class="bg-white dark:bg-[#111618] rounded-xl border border-slate-200 dark:border-[#3b4d54] overflow-hidden shadow-sm">
            <div class="p-8">
                <form method="post" class="space-y-6">

                    <!-- Ad Soyad -->
                    <div>
                        <label class="block text-sm font-bold mb-2">
                            Ad Soyad <span class="text-red-500">*</span>
                        </label>
                        <input type="text"
                               asp-for="NameSurname"
                               class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                      bg-white dark:bg-[#1c2427] focus:outline-none focus:ring-2
                                      focus:ring-primary/50 transition-all"
                               placeholder="Örn: Ayşe Yılmaz"
                               required />
                    </div>

                    <!-- Fotoğraf URL -->
                    <div>
                        <label class="block text-sm font-bold mb-2">
                            Fotoğraf URL <span class="text-red-500">*</span>
                        </label>
                        <input type="text"
                               asp-for="ImageUrl"
                               class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                      bg-white dark:bg-[#1c2427] focus:outline-none focus:ring-2
                                      focus:ring-primary/50 transition-all"
                               placeholder="Örn: https://site.com/images/avatar.jpg"
                               required />
                        <p class="text-xs text-slate-500 dark:text-[#9db2b9] mt-2">
                            Kare (1:1) oranında bir profil fotoğrafı önerilir
                        </p>
                    </div>

                    <!-- Unvan & Şirket -->
                    <div>
                        <label class="block text-sm font-bold mb-2">
                            Unvan & Şirket <span class="text-red-500">*</span>
                        </label>
                        <input type="text"
                               asp-for="Title"
                               class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                      bg-white dark:bg-[#1c2427] focus:outline-none focus:ring-2
                                      focus:ring-primary/50 transition-all"
                               placeholder="Örn: Product Manager - ABC Teknoloji"
                               required />
                    </div>

                    <!-- Yorum -->
                    <div>
                        <label class="block text-sm font-bold mb-2">
                            Yorum <span class="text-red-500">*</span>
                        </label>
                        <textarea asp-for="Comment"
                                  rows="6"
                                  class="w-full px-4 py-3 rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                         bg-white dark:bg-[#1c2427] focus:outline-none focus:ring-2
                                         focus:ring-primary/50 transition-all resize-none"
                                  placeholder="Kısa referans yorumu..."
                                  required></textarea>
                    </div>

               

                    <!-- Actions -->
                    <div class="flex items-center gap-3 pt-4 border-t border-slate-200 dark:border-[#3b4d54]">
                        <button type="submit"
                                class="flex items-center gap-2 px-6 py-3 bg-primary text-background-dark
                                       rounded-lg font-bold text-sm hover:opacity-90 transition-opacity">
                            <span class="material-symbols-outlined text-[20px]">check</span>
                            Kaydet
                        </button>

                        <a href="/Testimonial/TestimonialList/"
                           class="flex items-center gap-2 px-6 py-3 bg-slate-100 dark:bg-[#1c2427]
                                  text-slate-700 dark:text-slate-300 rounded-lg font-bold text-sm
                                  hover:bg-slate-200 dark:hover:bg-[#283539] transition-colors">
                            <span class="material-symbols-outlined text-[20px]">close</span>
                            İptal
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>